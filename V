<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ویبره قوی</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: Tahoma, sans-serif;
    background: linear-gradient(135deg, #1e1e2f, #2a2a40);
    color: #fff;
    margin: 0;
    padding: 20px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  h1 { font-size: 22px; margin-bottom: 10px; }
  .status {
    font-size: 16px;
    padding: 12px;
    border-radius: 10px;
    background: #33334d;
    margin: 10px 0 20px;
    min-width: 260px;
  }
  .status.on  { background: #1f7a3f; }
  .status.off { background: #7a1f1f; }
  button {
    font-family: inherit;
    font-size: 17px;
    padding: 15px 25px;
    margin: 8px;
    border: none;
    border-radius: 12px;
    color: #fff;
    cursor: pointer;
    min-width: 220px;
    transition: transform .1s;
  }
  button:active { transform: scale(.96); }
  #startBtn { background: #28a745; }
  #stopBtn  { background: #dc3545; }
  input[type="number"] {
    font-family: inherit;
    font-size: 16px;
    padding: 10px;
    border-radius: 8px;
    border: none;
    width: 100px;
    text-align: center;
  }
  label { display: block; margin: 15px 0 5px; font-size: 15px; }
  .warning {
    font-size: 13px;
    color: #ffb3b3;
    background: #3a1a1a;
    padding: 12px;
    border-radius: 10px;
    margin-top: 25px;
    max-width: 340px;
    line-height: 1.7;
  }
</style>
</head>
<body>

  <h1>🔊 ویبره قوی</h1>

  <label>مدت زمان (ثانیه):</label>
  <input type="number" id="duration" value="30" min="1" max="600">

  <div class="status off" id="status">آماده</div>

  <button id="startBtn">▶️ روشن کردن ویبره</button>
  <button id="stopBtn">⏹️ قطع ویبره</button>

  <div class="warning">
    ⚠️ توجه: اگر صفحه را ببندید یا به تب دیگری بروید،
    ویبره به‌طور خودکار توسط مرورگر قطع می‌شود.
    ادامه ویبره بعد از بستن فقط با اپ نیتیو ممکن است.
  </div>

<script>
// ==================== متغیرها ====================
let isVibrating   = false;
let loopInterval  = null;
let autoStopTimer = null;
let userDuration  = 30; // ثانیه

const startBtn = document.getElementById('startBtn');
const stopBtn  = document.getElementById('stopBtn');
const statusEl = document.getElementById('status');
const durationInput = document.getElementById('duration');

// ==================== بررسی پشتیبانی ====================
function vibrationSupported() {
  return 'vibrate' in navigator;
}

// ==================== شروع ویبره ====================
function startVibration() {
  if (!vibrationSupported()) {
    setStatus('❌ دستگاه شما از ویبره پشتیبانی نمی‌کند', false);
    return;
  }

  if (isVibrating) return;

  // خواندن مدت زمان از ورودی
  userDuration = parseInt(durationInput.value, 10) || 30;
  if (userDuration < 1)   userDuration = 1;
  if (userDuration > 600) userDuration = 600;

  isVibrating = true;

  // ✅ الگوی حداکثری: عدد بسیار بزرگ (حداکثر شدت + تداوم)
  // مرورگرها معمولاً این را به بیشترین حد ممکن محدود می‌کنند
  const MAX_MS = 60000; // ۶۰ ثانیه در هر چرخه
  navigator.vibrate(MAX_MS);

  // 🔁 حلقه‌ای برای نگه داشتن ویبره روشن
  // هر ۵ ثانیه دوباره فرمان ویبره می‌دهیم تا مطمئن شویم قطع نشده
  loopInterval = setInterval(() => {
    if (isVibrating) {
      navigator.vibrate(MAX_MS);
    }
  }, 5000);

  // ⏱️ قطع خودکار بعد از مدت زمان مشخص
  autoStopTimer = setTimeout(() => {
    stopVibration();
    setStatus('✅ زمان تمام شد - ویبره قطع شد', false);
  }, userDuration * 1000);

  setStatus(`🔴 ویبره روشن است (${userDuration} ثانیه)`, true);
}

// ==================== قطع ویبره ====================
function stopVibration() {
  isVibrating = false;

  if (loopInterval) {
    clearInterval(loopInterval);
    loopInterval = null;
  }
  if (autoStopTimer) {
    clearTimeout(autoStopTimer);
    autoStopTimer = null;
  }

  if (vibrationSupported()) {
    navigator.vibrate(0); // لغو ویبره
  }

  setStatus('⚪ ویبره قطع شد', false);
}

// ==================== به‌روزرسانی وضعیت ====================
function setStatus(text, isOn) {
  statusEl.textContent = text;
  statusEl.className = 'status ' + (isOn ? 'on' : 'off');
}

// ==================== رویدادها ====================
startBtn.addEventListener('click', startVibration);
stopBtn.addEventListener('click', stopVibration);

// ⛔ اگر کاربر تب را عوض کرد یا صفحه مخفی شد، ویبره را قطع کن
// (چون مرورگر به‌هرحال قطع می‌کند، حداقل ما وضعیت را درست نگه داریم)
document.addEventListener('visibilitychange', () => {
  if (document.hidden && isVibrating) {
    stopVibration();
    setStatus('⚠️ صفحه مخفی شد - ویبره قطع شد', false);
  }
});

// ⛔ اگر کاربر صفحه را بست
window.addEventListener('beforeunload', () => {
  if (vibrationSupported()) navigator.vibrate(0);
});
</script>

</body>
</html>
